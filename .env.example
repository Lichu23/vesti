# Supabase / PostgreSQL
# Copy this from Supabase: Project Settings -> Database -> Connection string.
# Use the Prisma-compatible pooled URL when deploying, and replace [YOUR-PASSWORD].
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct database connection, used by Prisma CLI commands and migrations.
# Copy from Supabase: Project Settings -> Database -> Connection string -> Direct connection.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase public project URL.
# Copy from Supabase: Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Supabase public anon key.
# Copy from Supabase: Project Settings -> API -> anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-public-anon-key"

# Auth.js / NextAuth
# Generate locally with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# GitHub OAuth provider for Auth.js.
# Create an OAuth app with callback URL:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="replace-with-github-client-id"
AUTH_GITHUB_SECRET="replace-with-github-client-secret"

# App URL
# Local development default.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
